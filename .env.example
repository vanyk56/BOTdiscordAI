# ─── DISCORD BOT ─────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
BOT_OWNER_ID=your_discord_id_here

# ─── RIVER AI (Все режимы кроме skala) ─────────────────────────────────────────
# Эндпоинт: https://api.river.ai/v1
# Модель: zai-org/GLM-5.3-Flash
RIVER_BASE_URL=https://api.river.ai/v1
RIVER_API_KEY=your_river_api_key_here
RIVER_MODEL=zai-org/GLM-5.3-Flash

# ─── YETA AI (Режим skala) ───────────────────────────────────────────────────
# Эндпоинт: https://platform.yeta.ai/v1
# Модель: deepseek-v4.1-flash-uncensored
YETA_BASE_URL=https://platform.yeta.ai/v1
YETA_API_KEY=your_yeta_api_key_here
YETA_MODEL=deepseek-v4.1-flash-uncensored

# ─── HTTP SERVER (Для бесплатного хостинга Koyeb / Render / HF) ────────────────
PORT=8080
